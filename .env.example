# Copia este archivo como .env en el servidor y completa los valores.
# docker-compose lo lee automáticamente. Nunca subas el .env al repositorio.

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Remitente de los correos. El dominio debe estar verificado en Resend.
CONTACT_EMAIL_FROM="TECNOATOM <web@tecnoatom.com>"

# Buzón que recibe los mensajes del formulario
CONTACT_EMAIL_TO=contacto@tecnoatom.com
